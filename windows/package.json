{
  "name": "business-software-erp",
  "productName": "Business Software ERP",
  "version": "1.0.0",
  "description": "Business Software ERP for Windows",
  "author": "Rubel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rubel.bizsoft",
    "productName": "Business Software ERP",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/OWNER/REPO/releases/download/win-latest"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "BusinessSoftwareERP-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "BusinessSoftwareERP-Portable-${version}.exe"
    }
  }
}